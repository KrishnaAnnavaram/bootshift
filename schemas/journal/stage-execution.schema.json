{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage execution record",
  "description": "What one stage attempt actually did. Written for every attempt, including attempts that refused, failed or crashed, and written beside that attempt's own artifacts. STAGE_DOCUMENT.md is a rendering of this file; this file is authoritative.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "stage_id",
    "purpose",
    "trigger",
    "started_at",
    "duration_ms",
    "status",
    "declared_steps",
    "executed_steps",
    "commands",
    "decisions",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "attempt_id": {
      "type": "string",
      "description": "Unique per attempt and independent of the output directory timestamp, so two attempts landing in the same millisecond remain distinguishable."
    },
    "stage_id": {
      "type": "string"
    },
    "stage_name": {
      "type": ["string", "null"]
    },
    "edge_id": {
      "type": ["string", "null"],
      "description": "Null for the analysis half; set for the six per-edge stages."
    },
    "purpose": {
      "type": ["string", "null"]
    },
    "trigger": {
      "type": "string",
      "enum": ["PIPELINE", "CLI", "EDGE_LOOP", "RETRY", "RESUME"]
    },
    "trigger_detail": {
      "type": ["string", "null"]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": ["string", "null"]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "state_before": {
      "type": ["string", "null"]
    },
    "state_after": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "DEGRADED", "REFUSED", "BLOCKED", "FAILED", "CRASHED", "INCOMPLETE"]
    },
    "summary": {
      "type": ["string", "null"]
    },
    "attempt_directory": {
      "type": ["string", "null"]
    },
    "declared_preconditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "precondition_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["precondition", "satisfied"],
        "properties": {
          "precondition": {"type": "string"},
          "satisfied": {"type": "boolean"},
          "detail": {"type": ["string", "null"]},
          "remediation": {"type": ["string", "null"]}
        }
      }
    },
    "declared_inputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "resolved_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "present"],
        "properties": {
          "artifact": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "present": {"type": "boolean"},
          "hash": {"type": ["string", "null"]}
        }
      }
    },
    "declared_steps": {
      "type": "array",
      "description": "Step ids the stage declared before running. Declared rather than accumulated, so a step that never executed is still present.",
      "items": {"type": "string"}
    },
    "executed_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "sequence", "status"],
        "properties": {
          "step_id": {"type": "string"},
          "sequence": {"type": "integer"},
          "name": {"type": ["string", "null"]},
          "purpose": {"type": ["string", "null"]},
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "SUCCESS", "SKIPPED", "DEGRADED", "REFUSED", "FAILED", "BLOCKED", "NOT_APPLICABLE"]
          },
          "status_reason": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "duration_ms": {"type": "integer"},
          "inputs": {"type": "array"},
          "outputs": {"type": "array"},
          "evidence_refs": {"type": "array"},
          "details": {"type": "object"},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "unexecuted_steps": {
      "type": "array",
      "description": "Declared steps still PENDING at finalization. Non-empty is a finding: the stage claims a capability it did not exercise.",
      "items": {"type": "string"}
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command_id", "sanitized_command", "exit_code", "result"],
        "properties": {
          "command_id": {"type": "string"},
          "stage_id": {"type": ["string", "null"]},
          "edge_id": {"type": ["string", "null"]},
          "attempt_id": {"type": ["string", "null"]},
          "step_id": {"type": ["string", "null"]},
          "executable": {"type": ["string", "null"]},
          "sanitized_command": {
            "type": "string",
            "description": "Redacted before storage. Arguments whose key reads as sensitive have their value replaced."
          },
          "working_directory": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "duration_ms": {"type": "integer"},
          "exit_code": {"type": "integer"},
          "timed_out": {"type": "boolean"},
          "stdout_evidence_ref": {"type": ["string", "null"]},
          "stderr_evidence_ref": {"type": ["string", "null"]},
          "stdout_lines": {"type": "integer"},
          "stderr_lines": {"type": "integer"},
          "environment_summary": {
            "type": "object",
            "description": "Variable names only. Values are never journalled."
          },
          "result": {
            "type": "string",
            "enum": ["SUCCESS", "FAILED", "TIMED_OUT", "NOT_STARTED"]
          }
        }
      }
    },
    "tool_invocations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "type", "made_by"],
        "properties": {
          "decision_id": {"type": "string"},
          "type": {"type": "string"},
          "subject": {"type": ["string", "null"]},
          "decision": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "alternatives_considered": {"type": "array"},
          "evidence_refs": {"type": "array"},
          "document_refs": {"type": "array"},
          "policy_refs": {"type": "array"},
          "confidence": {"type": ["string", "null"]},
          "made_by": {
            "type": "string",
            "enum": ["DETERMINISTIC_RULE", "POLICY", "HUMAN_DECISION", "AI_PROPOSAL"]
          },
          "authorized_by": {
            "type": ["string", "null"],
            "description": "What authorized the action. Never AI: an AI proposal must record the deterministic verification that authorized it."
          },
          "decided_at": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_references": {"type": "array", "items": {"type": "string"}},
    "document_references": {"type": "array", "items": {"type": "string"}},
    "migration_fact_references": {"type": "array", "items": {"type": "string"}},
    "impact_references": {"type": "array", "items": {"type": "string"}},
    "mutation_summary": {"type": "object"},
    "validation_summary": {"type": "object"},
    "retries": {"type": "array", "items": {"type": "object"}},
    "fallbacks": {
      "type": "array",
      "description": "Routes weaker than the declared one. A fallback is a statement about how much the result is worth, not a warning.",
      "items": {"type": "object"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "blind_spots": {"type": "array", "items": {"type": "object"}},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "hash": {"type": ["string", "null"]}
        }
      }
    },
    "metrics": {"type": "object"},
    "primary_artifact_hash": {"type": ["string", "null"]},
    "next_action": {"type": ["string", "null"]},
    "stop_reason": {"type": ["string", "null"]},
    "policy_hash": {"type": ["string", "null"]},
    "tool_version": {"type": ["string", "null"]},
    "rendering_error": {
      "type": ["string", "null"],
      "description": "Set when Markdown rendering failed for this attempt. Execution truth is preserved; the documentation defect is reported rather than hidden."
    }
  }
}
