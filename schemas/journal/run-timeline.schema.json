{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run timeline",
  "description": "Ordered record of every stage attempt in a run. Written after each attempt, so it survives a run that never reaches finalization. RUN_DOCUMENT.md is rendered from this plus the published artifact plane.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "attempt_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "run_id": {"type": ["string", "null"]},
    "generated_at": {"type": "string"},
    "attempt_count": {"type": "integer", "minimum": 0},
    "purpose": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "attempt_id", "status"],
        "properties": {
          "stage_id": {"type": "string"},
          "stage_name": {"type": ["string", "null"]},
          "attempt_id": {"type": "string"},
          "edge_id": {
            "type": ["string", "null"],
            "description": "Set for the six per-edge stages, so an edge's attempts can be resolved without following the single stage pointer."
          },
          "trigger": {
            "type": "string",
            "enum": ["PIPELINE", "CLI", "EDGE_LOOP", "RETRY", "RESUME"]
          },
          "start": {"type": ["string", "null"]},
          "end": {"type": ["string", "null"]},
          "duration_ms": {"type": "integer"},
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "DEGRADED", "REFUSED", "BLOCKED", "FAILED", "CRASHED", "INCOMPLETE"]
          },
          "summary": {"type": ["string", "null"]},
          "state_before": {"type": ["string", "null"]},
          "state_after": {"type": ["string", "null"]},
          "attempt_directory": {"type": ["string", "null"]},
          "stop_reason": {"type": ["string", "null"]},
          "next_action": {"type": ["string", "null"]},
          "command_count": {"type": "integer"},
          "decision_count": {"type": "integer"},
          "warning_count": {"type": "integer"},
          "error_count": {"type": "integer"},
          "unexecuted_step_count": {"type": "integer"},
          "rendering_error": {"type": ["string", "null"]}
        }
      }
    },
    "journal_failures": {
      "type": "array",
      "description": "Problems the journal itself hit. Non-empty means the audit trail has a hole in it.",
      "items": {"type": "string"}
    }
  }
}
