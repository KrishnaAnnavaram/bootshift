{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge plan",
  "description": "Per-edge frozen execution plan including the validation depth calculation.",
  "type": "object",
  "required": [
    "pipeline_stage",
    "schema_version",
    "generated_at",
    "run_id",
    "mutating",
    "blind_spots",
    "gaps",
    "stats",
    "edge_count",
    "edges"
  ],
  "properties": {
    "pipeline_stage": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "edge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream": {
      "type": "object"
    },
    "mutating": {
      "type": "boolean"
    },
    "repo_state": {
      "type": "object"
    },
    "baseline_binding": {
      "type": "object"
    },
    "environment_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object"
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "reconciliation_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "edge_class",
          "frozen_validation_depth",
          "checkpoint_reconciliation"
        ],
        "properties": {
          "edge_id": {
            "type": "string"
          },
          "edge_class": {
            "enum": [
              "PATCH",
              "MINOR",
              "PREPARATORY",
              "MAJOR_BOUNDARY"
            ]
          },
          "source_state": {
            "type": "string"
          },
          "target_state": {
            "type": "string"
          },
          "landing": {
            "type": "boolean"
          },
          "transit": {
            "type": "boolean"
          },
          "mandatory_checkpoint": {
            "type": "boolean"
          },
          "frozen_validation_depth": {
            "enum": [
              "BUILD_ONLY",
              "BUILD_AND_TESTS",
              "BUILD_TESTS_RUNTIME",
              "IMPACTED_DIFFERENTIAL",
              "FULL_DIFFERENTIAL"
            ]
          },
          "validation_depth_calculation": {
            "type": "object"
          },
          "checkpoint_reconciliation": {
            "enum": [
              "DECOMPOSED",
              "COLLAPSE_WITH_ESCALATED_VALIDATION",
              "BLOCK"
            ]
          },
          "tests_required": {
            "type": "boolean"
          },
          "runtime_required": {
            "type": "boolean"
          },
          "differential_required": {
            "type": "boolean"
          },
          "affected_file_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
